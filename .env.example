# Database (Supabase PostgreSQL via PgBouncer)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase - used to construct JWKS URI: ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# JWT verification uses ES256 (ECC P-256) via Supabase's public JWKS key.
# No JWT secret is needed here; Supabase issues and signs all tokens.
SUPABASE_URL="https://[project-ref].supabase.co"

# Redis
REDIS_URL="redis://:your_redis_password@localhost:6379"
REDIS_PASSWORD="your_redis_password"
