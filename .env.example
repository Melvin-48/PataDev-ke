# Database (Supabase PostgreSQL via PgBouncer)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase - used to construct JWKS URI: ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# JWT verification uses ES256 (ECC P-256) via Supabase's public JWKS key.
# No JWT secret is needed here; Supabase issues and signs all tokens.
SUPABASE_URL="https://[project-ref].supabase.co"

# Redis
REDIS_URL="redis://:your_redis_password@localhost:6379"
REDIS_PASSWORD="your_redis_password"

# App
PORT=3000
NODE_ENV=development

# Payments (fill in once a rail is chosen - see payments module)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
