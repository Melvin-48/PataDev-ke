# Database Connections (Prisma 7 / Supabase Pooled Connection)
# DATABASE_URL: Connect via PgBouncer transaction pooler (port 6543) for query execution
DATABASE_URL=
# DIRECT_URL: Direct connection to the database (port 5432) for running migrations
DIRECT_URL=

# Supabase Configurations (New Publishable/Secret API Keys System)
# Note: Legacy JWT-based keys (SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY) are deprecated/legacy.
# The new system uses Publishable keys (prefixed with sb_publishable_) and Secret keys (prefixed with sb_secret_).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Redis Configuration (Cache/Socket.io adapter)
REDIS_URL=
REDIS_PASSWORD=

# App Server Configuration
PORT=3000
NODE_ENV=development

# Paystack Payment Gateway Integration
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
