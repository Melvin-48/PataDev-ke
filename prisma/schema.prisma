generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  DEVELOPER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectSystemType {
  CRM
  POS
}

enum ProjectStatus {
  DRAFT
  OPEN
  MATCHED
  COMPLETED
  CANCELLED
  REMOVED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  PAID
}

enum LedgerEntryType {
  HELD
  COMMISSION
  PAYOUT
  REFUND
}

enum LedgerEntryStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id               String            @id @default(uuid())
  supabaseId       String            @unique
  email            String            @unique
  role             UserRole          @default(CLIENT)
  status           UserStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now())
  clientProfile    ClientProfile?
  developerProfile DeveloperProfile?
  bids             Bid[]
  messages         Message[]
  notifications    Notification[]
  disputesRaised   DisputeReport[]   @relation("DisputeRaisedBy")
  disputesAgainst  DisputeReport[]   @relation("DisputeAgainst")
  disputesResolved DisputeReport[]   @relation("DisputeResolvedBy")
  auditLogs        AuditLog[]
}

model ClientProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  businessName String
  businessType String?
  phone        String?
  projects     Project[]
}

model DeveloperProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  displayName        String
  bio                String?
  techStack          String[]
  listingTier        String?
  portfolioUrl       String?
  verificationStatus VerificationStatus @default(PENDING)
  rejectionReason    String?
  verifiedAt         DateTime?
}

model Project {
  id          String            @id @default(uuid())
  clientId    String
  client      ClientProfile     @relation(fields: [clientId], references: [id])
  title       String
  description String
  systemType  ProjectSystemType
  budgetMin   Decimal?
  budgetMax   Decimal?
  status      ProjectStatus     @default(DRAFT)
  createdAt   DateTime          @default(now())
  bids        Bid[]
}

model Bid {
  id              String        @id @default(uuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id])
  developerId     String
  developer       User          @relation(fields: [developerId], references: [id])
  proposedAmount  Decimal
  message         String?
  status          BidStatus     @default(PENDING)
  createdAt       DateTime      @default(now())
  milestones      Milestone[]
  messages        Message[]
  ledgerEntries   LedgerEntry[]
  disputes        DisputeReport[]
}

model Milestone {
  id            String          @id @default(uuid())
  bidId         String
  bid           Bid             @relation(fields: [bidId], references: [id])
  title         String
  description   String?
  amount        Decimal
  status        MilestoneStatus @default(PENDING)
  dueDate       DateTime?
  ledgerEntries LedgerEntry[]
}

model Message {
  id        String   @id @default(uuid())
  bidId     String
  bid       Bid      @relation(fields: [bidId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model LedgerEntry {
  id              String            @id @default(uuid())
  projectBidId    String
  bid             Bid               @relation(fields: [projectBidId], references: [id])
  milestoneId     String?
  milestone       Milestone?        @relation(fields: [milestoneId], references: [id])
  type            LedgerEntryType
  amount          Decimal
  status          LedgerEntryStatus @default(PENDING)
  idempotencyKey  String?           @unique
  createdAt       DateTime          @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  payload   Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DisputeReport {
  id             String        @id @default(uuid())
  bidId          String
  bid            Bid           @relation(fields: [bidId], references: [id])
  raisedById     String
  raisedBy       User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  againstId      String?
  against        User?         @relation("DisputeAgainst", fields: [againstId], references: [id])
  reason         String
  description    String?
  status         DisputeStatus @default(OPEN)
  resolutionNote String?
  resolvedById   String?
  resolvedBy     User?         @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
